FROM caddy:2.11.7-alpine@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f
# Both listeners use unprivileged ports; the upstream binary's file capability
# would prevent exec under cap_drop: ALL, so remove the unnecessary privilege.
RUN setcap -r /usr/bin/caddy && mkdir -p /data /config && chown -R 10001:10001 /data /config
COPY infra/Caddyfile /etc/caddy/Caddyfile
USER 10001:10001
