# Copy to .env for local overrides; never commit .env or .cache/local.env.
POSTGRES_PASSWORD=replace-with-random-url-safe-password
TABLE_REVIEW_MODELS=C:/absolute/path/table-review/models
TABLE_REVIEW_PORT=8000
TABLE_REVIEW_PUBLIC_ORIGIN=http://127.0.0.1:8000
TABLE_REVIEW_SECURE_COOKIES=false
TABLE_REVIEW_DEPLOYMENT_MODE=local
# Single-user local mode: set to true to skip the login screen on loopback (forbidden in hosted mode).
TABLE_REVIEW_LOCAL_AUTO_LOGIN=false

# Retention: disabled (keep forever) by default in local mode; 30 days default in hosted mode.
# Set a positive integer (e.g. 30) to auto-expire untouched documents, or "none" / "0" to disable.
TABLE_REVIEW_RETENTION_DAYS=none

# Extraction engine & compute device:
# Backend: auto | native_fast | docling | vlm
TABLE_REVIEW_EXTRACTION_BACKEND=auto
# Device: auto | cpu | cuda | mps
TABLE_REVIEW_EXTRACTION_DEVICE=auto

# Optional OpenAI-compatible Vision-Language Model (VLM) adapter (e.g. local Ollama or BYOK):
# Disabled by default in hosted mode unless TABLE_REVIEW_ALLOW_VLM_IN_HOSTED=true.
# TABLE_REVIEW_VLM_BASE_URL=http://127.0.0.1:11434/v1
# TABLE_REVIEW_VLM_MODEL=qwen2.5vl:7b
# TABLE_REVIEW_VLM_API_KEY=

# Hosted operation requires DEPLOYMENT_MODE=hosted, HTTPS origin, and TABLE_REVIEW_SECURE_COOKIES=true.
